# Runtime
NODE_ENV=development
PORT=3100                       # app binds 127.0.0.1 only
MOCK_APIS=true                  # true = no Google/SMTP calls (refused when NODE_ENV=production)
SITE_URL=http://127.0.0.1:3100  # public site URL, used in emails
CRON_SECRET=change-me-16-chars-min  # Bearer token for /api/cron/tick
MAX_UPLOAD_MB=95                # per file; Cloudflare caps proxied bodies at 100 MB
WHATSAPP_NUMBER=56900000000     # digits only, with country code

# Google Sheets (service account; share the sheet with this email)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=             # keep literal \n sequences
GOOGLE_SHEET_ID=
SHEET_TAB=Pedidos

# Google Drive (OAuth refresh token of the Gmail account that owns the folder; run npm run setup:oauth)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
DRIVE_FOLDER_ID=

# Mail (Gmail SMTP with an app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=                      # the Gmail account login (internal only)
SMTP_PASS=                      # Gmail app password
FROM_EMAIL=contacto@monolabprintstudio.cl
OPERATOR_EMAIL=                 # where new-order notifications go (internal only)
